msgid ""
"[Linux Kernel Mentorship Program](https://wiki.linuxfoundation.org/lkmp)"
msgstr ""

#: content/for/students.md:154
msgid ""
"[Youth Hacking 4 Freedom](https://fsfe.org/activities/yh4f/index.en.html) "
"from the FSFE"
msgstr ""

#: content/for/students.md:155
msgid "[Rails Girls](https://railsgirlssummerofcode.org/)"
msgstr ""

